+
+    public function testUnaryUnionWithGrid()
+    {
+        $g = $this->reader()->read(
+            'MULTIPOLYGON(((0 0, 2 0, 2 2, 0 2, 0 0)),'.
+            '((1 1, 3 1, 3 3, 1 3, 1 1)))');
