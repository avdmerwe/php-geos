+
+    public function testSymDifferenceNoGrid()
+    {
+        $a = $this->reader()->read('POLYGON((0 0, 2 0, 2 2, 0 2, 0 0))');
+        $b = $this->reader()->read('POLYGON((1 1, 3 1, 3 3, 1 3, 1 1))');
