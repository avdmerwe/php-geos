++CoordSeq_zvalArrayToDoubles(zval *arr, unsigned int *out_size)
++{
++    TSRMLS_FETCH();
++    HashTable *ht;
++    double *buf;
++    unsigned int n, i;
++    GEOS_PHP_ZVAL data;
