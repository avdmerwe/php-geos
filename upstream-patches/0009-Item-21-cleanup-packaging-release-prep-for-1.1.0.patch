+  (minimumBoundingCircle, minimumRotatedRectangle, minimumWidth,
+  minimumClearance, maximumInscribedCircle, largestEmptyCircle), distance
+  extras (distanceWithin, distanceIndexed, nearestPoints, frechet/Hausdorff
