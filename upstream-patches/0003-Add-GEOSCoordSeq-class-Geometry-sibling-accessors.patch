+        $gm = $reader->read('POINT M (1 2 99)');
+        $this->assertTrue($gm->hasM());
+        $this->assertFalse($gm->hasZ());
+
+        $gzm = $reader->read('POINT ZM (1 2 3 99)');
+        $this->assertTrue($gzm->hasM());
+        $this->assertTrue($gzm->hasZ());
+    }
