+<?php
+
+require './tests/TestHelper.php';
+
+class FactoriesTest extends GEOSTest
+{
+    public function testCreatePointFromXY()
+    {
+        $p = GEOSGeometry::createPointFromXY(1.5, 2.5);
+        $this->assertEquals('Point', $p->typeName());
+        $writer = new GEOSWKTWriter();
