+        $arc = GEOSGeometry::createCircularString($cs1);
+
+        $cs2 = new GEOSCoordSeq(2);
+        $cs2->setXY(0, 2, 0); $cs2->setXY(1, 3, 0);
+        $line = GEOSGeometry::createLineString($cs2);
+
+        $cc = GEOSGeometry::createCompoundCurve(array($arc, $line));
